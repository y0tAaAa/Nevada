# --- Провайдер модели (любой OpenAI-совместимый API) ---
# groq (по умолчанию) или nvidia
NEVADA_PROVIDER=groq

# Ключ: подойдёт общий NEVADA_API_KEY либо ключ провайдера
GROQ_API_KEY=gsk_your_api_key_here
# NVIDIA_API_KEY=nvapi-your_key_here

# Модель. Если не задана — берётся дефолт провайдера:
#   groq   -> llama-3.3-70b-versatile
#   nvidia -> meta/llama-3.3-70b-instruct
NEVADA_MODEL=llama-3.3-70b-versatile

# Свой endpoint (например, локальная Ollama) — переопределяет провайдера
# NEVADA_API_BASE=http://localhost:11434/v1

# --- Приложение ---
NEVADA_AUTOSTART=true
NEVADA_HOTKEY=ctrl+shift+space
NEVADA_LANGUAGE=ru
